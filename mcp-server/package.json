{
  "name": "ledger-mcp",
  "version": "1.4.0",
  "type": "module",
  "bin": {
    "ledger-mcp": "./build/index.js"
  },
  "scripts": {
    "build": "tsc && chmod 755 build/index.js",
    "dev": "tsc --watch",
    "start:stdio": "node build/index.js",
    "start:http": "node build/http.js",
    "test": "node -e \"console.error('MCP npm test is intentionally disabled: it uses the legacy Firestore emulator harness. Use npm run build plus a real-Firestore disposable smoke test. If you are intentionally working on the legacy harness, run npm run test:legacy:emulator.'); process.exit(1)\"",
    "test:legacy:emulator": "vitest run --pool=forks --poolOptions.forks.singleFork"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^5.1.0",
    "firebase-admin": "^13.0.0",
    "sharp": "^0.34.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
