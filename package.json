    "target:query-authority:test": "node --test scripts/tests/generate-target-query-logical-authority-crosswalk.test.mjs",
    "target:supabase:test:db": "npx --yes supabase@2.116.0 test db --local",
    "target:supabase:test:rpc": "node scripts/test-local-client-creation-rpc.mjs && node scripts/test-local-project-creation-rpc.mjs",
