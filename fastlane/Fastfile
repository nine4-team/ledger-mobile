opt_out_usage

default_platform(:ios)

APP_IDENTIFIER = "apps.nine4.ledger"
TEAM_ID = "5VHL56HV63"
PROJECT = "LedgeriOS/LedgeriOS.xcodeproj"
SCHEME = "LedgeriOS"
CONFIGURATION = "Release"
BUILD_DIR = "build/TestFlight"
DEFAULT_EXTERNAL_GROUPS = ["External Testing"]
DEFAULT_MARKETING_VERSION = "1.0"

def app_store_api_key
  key_id = ENV.fetch("APP_STORE_CONNECT_KEY_ID", "X5SX4S7NW5")
  issuer_id = ENV.fetch("APP_STORE_CONNECT_ISSUER_ID", "4827880b-e626-4e8e-a16b-c66db4355e12")
  key_filepath = ENV.fetch(
    "APP_STORE_CONNECT_KEY_FILEPATH",
    File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{key_id}.p8")
  )

  UI.user_error!("APP_STORE_CONNECT_ISSUER_ID is required for Fastlane App Store Connect API auth") if issuer_id.to_s.empty?
  UI.user_error!("App Store Connect key file not found: #{key_filepath}") unless File.exist?(key_filepath)

  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer_id,
    key_filepath: key_filepath,
    duration: 1200,
    in_house: false
  )
end

def external_groups_from(options)
  raw = options[:groups] || ENV["TESTFLIGHT_GROUPS"]
  return DEFAULT_EXTERNAL_GROUPS if raw.to_s.empty?

  raw.split(",").map(&:strip).reject(&:empty?)
end

def marketing_version_from(options)
  (options[:version] || ENV["MARKETING_VERSION"] || DEFAULT_MARKETING_VERSION).to_s
end

def next_build_number(api_key:, version:)
  latest = latest_testflight_build_number(
    api_key: api_key,
    app_identifier: APP_IDENTIFIER,
    version: version,
    initial_build_number: 0
  )

  (latest.to_i + 1).to_s
end

def build_number_from(options, api_key, version)
  explicit = options[:build_number] || ENV["BUILD_NUMBER"]
  return explicit.to_s unless explicit.to_s.empty?

  next_build_number(api_key: api_key, version: version)
end

def release_notes_from(options)
  options[:changelog] || ENV["TESTFLIGHT_CHANGELOG"] || "Ledger beta update"
end

platform :ios do
  desc "Build and upload Ledger to TestFlight"
  lane :upload_testflight do |options|
    api_key = app_store_api_key
    version = marketing_version_from(options)
    build_number = build_number_from(options, api_key, version)
    changelog = release_notes_from(options)

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: CONFIGURATION,
      export_method: "app-store",
      export_team_id: TEAM_ID,
      output_directory: BUILD_DIR,
      output_name: "Ledger-#{version}-#{build_number}.ipa",
      include_symbols: true,
      clean: false,
      xcargs: "DEVELOPMENT_TEAM=#{TEAM_ID} CODE_SIGN_STYLE=Automatic MARKETING_VERSION=#{version} CURRENT_PROJECT_VERSION=#{build_number}",
      export_xcargs: "-allowProvisioningUpdates"
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      app_platform: "ios",
      ipa: "#{BUILD_DIR}/Ledger-#{version}-#{build_number}.ipa",
      changelog: changelog,
      uses_non_exempt_encryption: false,
      skip_waiting_for_build_processing: false
    )

    UI.success("Uploaded Ledger #{version} (#{build_number}) to TestFlight")
  end

  desc "Build, upload, wait for processing, and attach Ledger to external TestFlight groups"
  lane :external_testflight do |options|
    api_key = app_store_api_key
    version = marketing_version_from(options)
    build_number = build_number_from(options, api_key, version)
    changelog = release_notes_from(options)
    groups = external_groups_from(options)

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: CONFIGURATION,
      export_method: "app-store",
      export_team_id: TEAM_ID,
      output_directory: BUILD_DIR,
      output_name: "Ledger-#{version}-#{build_number}.ipa",
      include_symbols: true,
      clean: false,
      xcargs: "DEVELOPMENT_TEAM=#{TEAM_ID} CODE_SIGN_STYLE=Automatic MARKETING_VERSION=#{version} CURRENT_PROJECT_VERSION=#{build_number}",
      export_xcargs: "-allowProvisioningUpdates"
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      app_platform: "ios",
      ipa: "#{BUILD_DIR}/Ledger-#{version}-#{build_number}.ipa",
      changelog: changelog,
      uses_non_exempt_encryption: false,
      distribute_external: true,
      groups: groups,
      notify_external_testers: true,
      skip_waiting_for_build_processing: false
    )

    UI.success("Uploaded Ledger #{version} (#{build_number}) and requested external distribution to #{groups.join(', ')}")
  end

  desc "Attach an already-uploaded Ledger build to external TestFlight groups"
  lane :distribute_existing_external do |options|
    api_key = app_store_api_key
    version = marketing_version_from(options)
    build_number = options[:build_number] || ENV["BUILD_NUMBER"]
    changelog = release_notes_from(options)
    groups = external_groups_from(options)

    UI.user_error!("Pass build_number: or set BUILD_NUMBER") if build_number.to_s.empty?

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      app_platform: "ios",
      build_number: build_number.to_s,
      changelog: changelog,
      distribute_external: true,
      distribute_only: true,
      groups: groups,
      notify_external_testers: true,
      skip_waiting_for_build_processing: false,
      uses_non_exempt_encryption: false,
      app_version: version
    )

    UI.success("Requested external TestFlight distribution for Ledger #{version} (#{build_number}) to #{groups.join(', ')}")
  end
end
