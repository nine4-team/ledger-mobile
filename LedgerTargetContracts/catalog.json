  "authorizationPolicies": [
    {
      "id": "account_member",
      "description": "Derive the Principal from authentication and require active membership in the requested Account."
    },
    {
      "id": "build_validated_local",
      "description": "Require a validated target build environment before opening any local infrastructure."
    },
    {
      "id": "client_manager",
      "description": "Derive the Principal from authentication and require active membership with Client-management capability in the requested Account."
    },
    {
      "id": "project_setup_manager",
      "description": "Derive the Principal from authentication; require active Project-management capability, Client-management capability when creating a Client, and Project-budget capability plus category visibility when allocations are present."
    },
    {
      "id": "project_reader",
      "description": "Derive the Principal from authentication and require active Account membership plus exact Project visibility, including archived Projects."
    },
    {
      "id": "project_archive_manager",
      "description": "Derive the Principal from authentication and require active Account membership with Project-management capability."
    },
    {
      "id": "local_principal_account",
      "description": "Require the active local Principal and Account namespace; this is local scope, not fresh server authorization."
    },
    {
      "id": "public_contract_metadata",
      "description": "Expose only bounded version, capability, deprecation and stable contract metadata with no tenant or persistence data."
    }
  ],
  "telemetryClasses": [
